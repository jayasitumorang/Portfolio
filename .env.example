# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Required for the GitHub webhook. Any long random string; use the same value in GitHub's webhook settings.
GITHUB_WEBHOOK_SECRET=

# Optional. A GitHub token (no scopes needed) raises the API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Optional. Your final site address, used for share previews. Defaults to https://jayasitumorang.vercel.app
NEXT_PUBLIC_SITE_URL=
