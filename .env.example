# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Required for the GitHub webhook. Any long random string; use the same value in GitHub's webhook settings.
GITHUB_WEBHOOK_SECRET=

# Optional. A GitHub token (no scopes needed) raises the API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Visitor log (Supabase). Project URL from Supabase → Project Settings → Data API.
SUPABASE_URL=
# Supabase secret key (sb_secret_...). Server only: never commit it or share it.
SUPABASE_SECRET_KEY=
# Password for the private /stats page.
STATS_PASSWORD=

# Optional. Only needed with a custom domain; on Vercel the production address is detected automatically.
SITE_URL=

# Book sales over QRIS (Midtrans Snap). Server key from Midtrans → Settings → Access Keys.
# Server only: never commit it. Sandbox keys start with SB-Mid-server-.
MIDTRANS_SERVER_KEY=
# Client key from the same page (Mid-client-... / SB-Mid-client-...). Public: lets the order page
# embed Snap. Without it buyers get a button to Midtrans's own payment page instead.
MIDTRANS_CLIENT_KEY=
# true = live payments (api.midtrans.com); anything else = sandbox.
MIDTRANS_IS_PRODUCTION=false
